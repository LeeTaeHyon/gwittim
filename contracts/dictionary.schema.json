{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwittim.invalid/contracts/dictionary.schema.json",
  "title": "공통 사전 파일",
  "description": "contracts/dictionaries/*.json 형식. 코드는 불투명 ID이며 한 번 쓰인 코드는 의미를 바꾸지 않음 (폐기 시 deprecated=true).",
  "type": "object",
  "additionalProperties": false,
  "required": ["dictionary", "status", "updated", "source", "items"],
  "properties": {
    "dictionary": { "enum": ["universities", "majors", "categories", "interests", "roles"] },
    "status": { "enum": ["draft", "approved"] },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "minLength": 1, "description": "항목의 근거 (자료·확인 날짜)." },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name_ko"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/code" },
          "name_ko": { "type": "string", "minLength": 1 },
          "university_id": { "$ref": "common.schema.json#/$defs/code" },
          "deprecated": { "type": "boolean" }
        }
      }
    }
  }
}
