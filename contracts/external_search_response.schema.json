{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gwittim.invalid/contracts/external_search_response.schema.json",
  "title": "외부 공고 찾기 응답",
  "description": "DeepSeek 웹 검색 결과 최대 5개. verified=true는 검색 출처로 확인된 것(url은 검색 도구가 실제로 본 페이지), verified=false는 출처로 확인하지 못해 모델이 낸 주소 그대로인 것(앱은 '출처 확인 안 됨' 표시). deadline은 출처 문장에서 확인된 날짜만(아니면 null, verified=false면 항상 null). 확인된 것이 먼저 온다. 주최는 보내지 않고 source_name(출처 사이트 이름)을 보냄. 결과가 없으면 charged=false(크레딧 환불). 서버에 저장하지 않음. D-047. 원문 읽기(2026-11-23): read=true면 DeepSeek가 그 페이지를 실제로 열어 응모 대상(target)·주최(organizer)·마감을 읽었고, verdict는 그 조건으로 귀띔 판정 규칙이 낸 결과(met·needs_check). 미충족은 결과에서 빼고 excluded_not_met에 개수만. read=false면 verdict·target·organizer는 null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "charged",
    "searched_at",
    "excluded_not_met"
  ],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "source_name",
          "deadline",
          "reason",
          "verified",
          "verdict",
          "target",
          "organizer",
          "read"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "source_name": {
            "type": "string",
            "minLength": 1
          },
          "deadline": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "type": "boolean",
            "description": "검색 출처로 확인했는지. false면 '출처 확인 안 됨'"
          },
          "verdict": {
            "enum": [
              "met",
              "needs_check",
              null
            ],
            "description": "원문 조건으로 낸 판정. 원문을 못 읽었으면 null. 미충족은 오지 않음"
          },
          "target": {
            "type": [
              "string",
              "null"
            ],
            "description": "원문의 응모 대상 문장(그대로 옮김)"
          },
          "organizer": {
            "type": [
              "string",
              "null"
            ],
            "description": "원문의 주최·주관"
          },
          "read": {
            "type": "boolean",
            "description": "DeepSeek가 원문 페이지를 실제로 열었는지"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verified": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "deadline": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "read": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "verdict": {
                  "const": null
                },
                "target": {
                  "type": "null"
                },
                "organizer": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "charged": {
      "type": "boolean"
    },
    "searched_at": {
      "$ref": "common.schema.json#/$defs/utc_timestamp"
    },
    "excluded_not_met": {
      "type": "integer",
      "minimum": 0,
      "description": "원문 조건으로 미충족이라 뺀 결과 수"
    }
  }
}
