# 귀띔(Gwittim) 환경변수 목록
#
# 실제 값은 각자 로컬 .env 또는 Cloud Run 환경 설정에 둡니다.
#
# 작성 규칙 (SPEC §10)
# - 이 파일에는 변수명과 설명만 적습니다. 실제 값은 넣지 않습니다.
# - 실제 값은 각자 로컬 .env 에 두며 .env 는 커밋하지 않습니다.
# - 변수가 결정되면 해당 PR에서 이 파일에 이름·설명·사용 위치를 추가합니다.
#
# 형식 예시 (실제 변수 아님):
# # 설명 / 사용 위치
# VARIABLE_NAME=

# Firebase 프로젝트 ID (dev/prod 분리, D-004). 로컬 에뮬레이터는 demo-gwittim
# 사용 위치: backend/api/server.py
GWITTIM_FIREBASE_PROJECT_ID=

# 로컬 에뮬레이터 사용 시에만 (예: 127.0.0.1:8080, 127.0.0.1:9099). 운영에서는 비워 둡니다.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
